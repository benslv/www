---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { slugify } from "../../utils/slugify";

import { jade, sage } from "@radix-ui/colors";

const { movie } = Astro.props;

export const getStaticPaths = (async () => {
	const movies = await getCollection("movies");

	return movies.map((movie) => ({
		params: { id: movie.id },
		props: { movie },
	}));
}) satisfies GetStaticPaths;

const posters = import.meta.glob<{ default: ImageMetadata }>("./*.jpg", {
	base: "/src/content/movies/posters",
});

const posterSrc = `./${slugify(`${movie.data.name} ${movie.data.year}`)}.jpg`;
const poster = posters[posterSrc];

const rating = movie.data.rating || 0;
const fullStars = Math.floor(rating);
const halfStar = fullStars !== rating;

const { Content } = await render(movie);

const transitionName = `${movie.data.date}-${movie.data.name}-${movie.data.year}`;
---

<Layout title={movie.data.name}>
	<div class="grid">
		{
			poster && (
				<Image
					src={poster()}
					alt={movie.data.name}
					transition:name={transitionName}
				/>
			)
		}
		<div>
			<p class="date">
				{new Intl.DateTimeFormat("en-GB").format(movie.data.date)}
			</p>
			<Content />
			<div class="star-container">
				{
					Array.from({ length: fullStars }, () => (
						<Icon name="full-star" />
					))
				}
				{halfStar && <Icon name="half-star" />}
			</div>
		</div>
	</div>
</Layout>

<style define:vars={{ ...jade, ...sage }}>
	.grid {
		display: grid;
		grid-template-columns: max-content 1fr;
		column-gap: 1rem;
	}

	.date {
		color: var(--sage11);
	}

	img {
		border-radius: 4px;
		outline: 1px solid var(--sage6);
	}

	.star-container {
		display: flex;
		color: var(--jade9);
	}
</style>
