---
import { jade, sage } from "@radix-ui/colors";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { slugify } from "../utils/slugify";

const movies = await getCollection("movies").then((data) =>
	data.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime()),
);

const posters = import.meta.glob<{ default: ImageMetadata }>("./*.jpg", {
	base: "/src/content/movies/posters",
});
---

<Layout>
	<h1>Movies</h1>
	<div id="movieList">
		{
			movies.map(({ id, data }) => {
				const transitionName = `${data.date}-${data.name}-${data.year}`;
				const imageSrc = `./${slugify(`${data.name} ${data.year}`)}.jpg`;

				const highlight = (data.rating ?? 0) > 4;

				const poster = posters[imageSrc];
				return (
					<>
						{poster ? (
							<a
								href={`/movies/${id}`}
								class:list={[{ highlight }]}
							>
								<Image
									src={poster()}
									alt={data.name}
									transition:name={transitionName}
								/>
							</a>
						) : null}
					</>
				);
			})
		}
	</div>
</Layout>

<style define:vars={{ ...jade, ...sage }}>
	#movieList {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));

		a {
			border-radius: 4px;
			overflow: hidden;
			outline: 1px solid var(--sage6);
			transition: 0.1s transform ease;

			&.highlight {
				outline: 2px solid var(--jade7);
				box-shadow: 0 2px 10px var(--jade7);
			}

			&:hover {
				transform: scale(1.05);
			}
		}
		img {
			aspect-ratio: auto calc(2 / 3);
		}
	}
</style>
