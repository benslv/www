---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { slugify } from "../utils/slugify";

const movies = await getCollection("movies").then((data) =>
	data.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime()),
);

const posters = import.meta.glob<{ default: ImageMetadata }>("./*.jpg", {
	base: "/src/content/movies/posters",
});
---

<Layout>
	<h1>Movies</h1>
	<div id="movieList">
		{
			movies.map(({ id, data }) => {
				const imageSrc = `./${slugify(`${data.name} ${data.year}`)}.jpg`;

				const poster = posters[imageSrc];
				return (
					<>
						{poster ? (
							<a href={`/movies/${id}`}>
								<Image src={poster()} alt={data.name} />
							</a>
						) : null}
					</>
				);
			})
		}
	</div>
</Layout>

<style>
	#movieList {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));

		img {
			aspect-ratio: auto calc(2 / 3);
			/* border: 1px solid black; */
			border-radius: 4px;
			box-shadow: 0 1px 4px grey;
		}
	}
</style>
